# Copie para .env.local (ignorado pelo git). Só variáveis VITE_ chegam ao navegador:
# nunca coloque em VITE_ service role, chaves de terceiros ou segredos de webhook (SECURITY.md).

# Supabase local (npm run db:start). A chave anônima aparece em `npx supabase status`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Servidor (server/, API em /api/*). Sem prefixo VITE_: lidas só pelo Node (Vercel Functions e
# `npm run dev`), nunca vão para o bundle. A service role do Supabase local aparece em
# `npx supabase status`; em homologação e produção fica só nas variáveis da Vercel.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
