# Copie para .env.local (ignorado pelo git). Só variáveis VITE_ chegam ao navegador:
# nunca coloque aqui service role, chaves de terceiros ou segredos de webhook (SECURITY.md).

# Supabase local (npm run db:start). A chave anônima aparece em `npx supabase status`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
